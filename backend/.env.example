# ============================================================================
# 后端环境变量示例
# 复制为 .env 后按需修改（.env 已被 .gitignore 排除，不会提交到仓库）
# ============================================================================

# ---- 运行环境：development / testing / production ----
FLASK_CONFIG=development

# ---- 基础 ----
APP_NAME=校园生活平台
SECRET_KEY=please-change-this-secret-key
DEBUG=True
HOST=127.0.0.1
PORT=5000

# ---- 接口前缀 ----
API_PREFIX=/api/v1

# ---- 数据库 ----
# 开发：留空则使用 backend/school_life.db（SQLite）
# DATABASE_URL=sqlite:///E:/Project_graduation/backend/school_life.db
# 部署：MySQL（需 pip install PyMySQL）
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/school_life?charset=utf8mb4

# ---- JWT ----
JWT_SECRET_KEY=please-change-this-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_DAYS=7
JWT_ISSUER=school-life-platform

# ---- 跨域（前后端同域部署时可收紧为具体域名） ----
CORS_ORIGINS=*

# ---- 上传 ----
# UPLOAD_FOLDER 留空则使用 backend/uploads
# UPLOAD_FOLDER=E:/Project_graduation/backend/uploads
MAX_CONTENT_MB=50
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,mp4,mov

# ---- 分页 ----
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# ---- 业务开关（会被 system_configs 表中的配置覆盖） ----
POST_AUDIT_ENABLED=1
REGISTER_CAPTCHA_ENABLED=1
RECYCLE_RETENTION_COUNT=10
GUEST_CAN_LIST=1
GUEST_CAN_DETAIL=0
SECURITY_NOTICE_ENABLED=1

# ---- 仅在开发环境建议开启：验证码接口回传明文，便于联调 ----
CAPTCHA_DEBUG=1
